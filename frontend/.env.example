# Copy to .env to override the defaults. Nothing is required for local development:
# without AUTH_SECRET a development-only secret is used (production must set it).

# next-auth session encryption key. REQUIRED in production. Generate one with: bunx auth secret
AUTH_SECRET=

# Where the browser and the Next server reach the .NET API and the app itself.
# In Development the API serves plain HTTP on http://localhost:5000 (the default).
NEXT_PUBLIC_SERVER_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional, only if you point NEXT_PUBLIC_SERVER_URL at the API's https endpoint
# (https://localhost:7043): its dev certificate is self-signed, so let the Next server call it.
# Development only, never set this in production.
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Production behind a proxy: trust the forwarded host header.
# AUTH_TRUST_HOST=true

# Optional: per-user rate limiting of tRPC calls via Upstash. Leave empty to disable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
