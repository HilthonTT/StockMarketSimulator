# Copy to .env and fill in. Only AUTH_SECRET is required for local development.

# next-auth session encryption key. Generate one with: bunx auth secret
AUTH_SECRET=

# Where the browser and the Next server reach the .NET API and the app itself.
NEXT_PUBLIC_SERVER_URL=https://localhost:7043
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The API's local dev certificate is self-signed; let the Next server call it.
# Development only, never set this in production.
NODE_TLS_REJECT_UNAUTHORIZED=0

# Optional: per-user rate limiting of tRPC calls via Upstash. Leave empty to disable.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
